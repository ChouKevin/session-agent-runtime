# Private runtime.env: mode 600; never source it as shell code or commit it.
# Existing application-owner credentials only; never use cluster-superuser credentials.
# Obtain the password from the authorized private source; do not generate a replacement.
SESSION_AGENT_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/session_agent
SESSION_AGENT_DATASOURCE_USERNAME=session_agent
SESSION_AGENT_DATASOURCE_PASSWORD=
# Optional Slack: configure all three or leave all three empty.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# OPENAI_API_KEY is the gateway bearer in a separate private gateway.env.
