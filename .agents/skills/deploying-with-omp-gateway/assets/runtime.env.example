# Private runtime.env: mode 600; never source it as shell code or commit it.
# Use a generated alphanumeric/hex database password, shared with Compose.
SESSION_AGENT_POSTGRES_PASSWORD=
# Optional Slack: configure all three or leave all three empty.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# OPENAI_API_KEY is the gateway bearer in a separate private gateway.env.
