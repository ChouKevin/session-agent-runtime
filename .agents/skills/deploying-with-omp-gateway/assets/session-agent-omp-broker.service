[Unit]
Description=OMP authentication broker for Session Agent Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/omp auth-broker serve --bind=127.0.0.1:8765
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
