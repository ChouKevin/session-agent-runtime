# Run ./docker/runtime.sh init, then edit docker/.env before the live run. Do not commit local credentials.
# Optional generic MCP connections for Docker Compose; leave empty for zero connections.
# Header values, when needed, should be supplied by the deployment environment or secret manager.
SESSION_AGENT_MCP_CONFIGURATION_JSON=
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite
SESSION_AGENT_POSTGRES_PASSWORD=
SESSION_AGENT_PORT=8090
# Leave empty for the repository logs/ directory, or use a dedicated absolute host path.
SESSION_AGENT_LOG_DIR=

# Reserved for a future transport integration. The current runtime does not consume them.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
